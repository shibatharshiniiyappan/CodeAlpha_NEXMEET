# ==============================================================================
# NEXMEET - Environment Configuration Template
# ==============================================================================
# NOTE: This file documents required and optional environment variables.
# NEVER commit real credentials, secrets, or API keys to version control.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Server Port:
# Local development default is 3000 (or 8080 depending on container setup).
# On Render / Cloud Run, the cloud platform automatically injects the PORT environment variable.
PORT=3000

# Environment Mode:
# Set to 'development' locally for Vite live reload and debug logging.
# Set to 'production' on Render / production deployments to serve optimized static assets.
NODE_ENV=development

# Google Gemini API Key:
# Optional / Recommended: Enables AI Mission Control, workload analysis, and smart idea decomposition.
# If omitted or unconfigured, NEXMEET automatically falls back to its deterministic offline rule planner.
GEMINI_API_KEY="your_gemini_api_key_here"

# Public Application URL:
# Used for generating shareable meeting links and WebSocket origins.
# Local default: http://localhost:3000
# Production: https://your-nexmeet-deployment.onrender.com
APP_URL="http://localhost:3000"
